# Copy to terraform.tfvars (gitignored) and fill in your own values.

aws_region = "ap-south-1"
name_prefix = "sals"

# Set to false to tear down the NAT gateway when the infra is idle (cost saving).
enable_nat = true

# Your current public IP, in CIDR form, e.g. "203.0.113.4/32".
# Find it with: curl.exe -s https://checkip.amazonaws.com
owner_ip_cidr = "CHANGE_ME/32"

# GitHub's published webhook source CIDRs (https://api.github.com/meta -> "hooks").
# Leave as [] to rely on Jenkins' Poll SCM trigger instead of a live webhook.
github_webhook_cidrs = []

# Contents of your SSH public key, e.g.: (Get-Content ~/.ssh/id_ed25519.pub)
ssh_public_key = "ssh-ed25519 AAAA... your-key-here"

proxy_instance_type   = "t3.micro"
app_instance_type     = "t3.medium"
jenkins_instance_type = "t3.medium"
