# TEMPLATE ONLY (app EC2). The real .env is generated on that EC2 from SSM Parameter Store.
# Never commit a real .env.
# Rules for values: no spaces, no $ # quotes. Use alphanumeric DB passwords
# (special characters break JDBC/Mongo URIs and docker compose interpolation).

# --- MySQL (RDS) ---
SPRING_DATASOURCE_URL=jdbc:mysql://<rds-endpoint>:3306/sals?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=<db-user>
SPRING_DATASOURCE_PASSWORD=<from-ssm>

# --- DocumentDB (TLS disabled via cluster parameter group for this mini-project) ---
SPRING_DATA_MONGODB_URI=mongodb://<user>:<password>@<docdb-cluster-endpoint>:27017/sals?authSource=admin&replicaSet=rs0&readPreference=secondaryPreferred&retryWrites=false

# --- App secrets ---
GEMINI_API_KEY=<new-rotated-key>
APP_JWT_SECRET=<long-random-hex>
SPRING_MAIL_USERNAME=<gmail-address>
SPRING_MAIL_PASSWORD=<gmail-app-password-without-spaces>

# --- Public URL of the app = the reverse proxy (used by Spring for CORS / links) ---
VITE_FE_URL=https://<reverse-proxy-elastic-ip-or-domain
